APP_VERSION=0.1.0
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5433/system_design_copilot
DATABASE_USERNAME=system_design_copilot
DATABASE_PASSWORD=replace-with-local-database-password
POSTGRES_DB=system_design_copilot
POSTGRES_USER=system_design_copilot
POSTGRES_PASSWORD=replace-with-local-database-password
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT=500ms
REDIS_COMMAND_TIMEOUT=500ms
REDIS_HEALTH_ENABLED=true
REDIS_RATE_LIMITS_ENABLED=true
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
# OpenRouter provides the OpenAI-compatible AI endpoint used by Copilot and Reviews.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_COPILOT_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_REVIEW_MODEL=openai/gpt-5.6-luna
AI_REQUEST_TIMEOUT=30s
AI_MAX_OUTPUT_TOKENS=4096
AI_DAILY_BUDGET_USD=0.10
AI_CONSENT_POLICY_VERSION=2026-08-01
CLERK_JWT_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_JWT_AUDIENCE=system-design-copilot-api
CLERK_AUTHORIZED_PARTY=http://localhost:3000
CLERK_JWK_SET_URI=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
FREE_ACTIVE_WORKSPACE_LIMIT=10
FREE_COPILOT_TURNS_PER_MONTH=50
FREE_REVIEWS_PER_MONTH=5
# Comma-separated Clerk subjects authorized to release curated Challenge content.
CONTENT_OPERATOR_CLERK_SUBJECTS=user_replace-with-content-operator
STRIPE_SECRET_KEY=sk_test_replace-with-stripe-test-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-stripe-test-webhook-secret
STRIPE_PRO_PRICE_ID=price_replace-with-stripe-test-pro-price-id
# Required when test-mode Pro access is enabled. Use a dedicated Clerk test-user subject.
STRIPE_SYNTHETIC_CLERK_SUBJECT=user_replace-with-dedicated-test-user
STRIPE_TEST_PRO_ENABLED=false
# Local-only convenience switch. Requires STRIPE_TEST_PRO_ENABLED=true and a sk_test_ Stripe key.
STRIPE_ALLOW_ALL_TEST_USERS=false
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/billing/cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/account
STRIPE_CHECKOUT_COOLDOWN_SECONDS=60
STRIPE_PAST_DUE_GRACE_DAYS=7
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
CLERK_SECRET_KEY=sk_test_replace-with-clerk-backend-secret
CLERK_BACKEND_API_BASE_URL=https://api.clerk.com/v1/
