    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^28.1.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
